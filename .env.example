# Optional. With a key the partner uses the Claude API.
ANTHROPIC_API_KEY=
# Optional overrides
DW_MODEL=claude-opus-5
DW_WEB_SEARCH=on
PORT=8787

# Or run the partner through your local Claude Code CLI, on your own subscription
# (personal, local use only). Picked automatically when there's no API key and `claude` is installed.
# DW_PARTNER=claude-cli        # api | claude-cli | offline
# DW_CLI_MODEL=claude-opus-5-5
# DW_CLI_EFFORT=high           # low | medium | high | xhigh | max
# DW_CLI_PATH=claude
